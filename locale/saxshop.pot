msgstr ""

#: ui_dialogs.py:4595
msgid "Line"
msgstr ""

#: ui_dialogs.py:4599
msgid ""
"Solid raster fill of the size labels on dies. More legible on dark "
"acrylic but slower."
msgstr ""

#: ui_dialogs.py:4602
msgid ""
"Single-stroke outline of the size labels on dies. Fastest; readable on "
"light acrylic."
msgstr ""

#: ui_dialogs.py:4609
