msgstr "i valori attuali"

#: ui_dialogs/gcode_settings.py:782 ui_dialogs/sizing.py:1992
msgid "Discard unsaved changes?"
msgstr "Scartare le modifiche non salvate?"

#: ui_dialogs/gcode_settings.py:783 ui_dialogs/sizing.py:1993
#, python-brace-format
msgid ""
"You have unsaved edits to {label}.\n"
"\n"
"Loading '{name}' will discard them. Continue?"
msgstr ""
"Ha modifiche non salvate in {label}.\n"
"\n"
"Caricare '{name}' le scarterà. Continuare?"

#: ui_dialogs/gcode_settings.py:799
#, python-brace-format
msgid "Save {label} Preset"
msgstr "Salva preset {label}"

#: ui_dialogs/gcode_settings.py:800
#, python-brace-format
msgid "Save the current {label} fields as a preset."
msgstr "Salva i campi {label} attuali come preset."

#: ui_dialogs/gcode_settings.py:808 ui_dialogs/sizing.py:1168
#: ui_dialogs/sizing.py:2728 ui_dialogs/sizing.py:2742
#: ui_dialogs/sizing.py:2746
msgid "Save Preset"
msgstr "Salva preset"

#: ui_dialogs/gcode_settings.py:809
#, python-brace-format
msgid ""
"One or more {label} fields has an invalid value. Fix it before saving as "
"a preset."
msgstr ""
"Uno o più campi {label} hanno un valore non valido. Lo corregga prima di "
"salvarlo come preset."

#: ui_dialogs/gcode_settings.py:824 ui_dialogs/gcode_settings.py:829
#: ui_dialogs/gcode_settings.py:838 ui_dialogs/gcode_settings.py:845
#: ui_dialogs/sizing.py:2029 ui_dialogs/sizing.py:2032
#: ui_dialogs/sizing.py:2044 ui_dialogs/sizing.py:2050
msgid "Rename Preset"
msgstr "Rinomina preset"

#: ui_dialogs/gcode_settings.py:830 ui_dialogs/sizing.py:2033
#, python-brace-format
msgid "New name for '{old}':"
msgstr "Nuovo nome per '{old}':"

#: ui_dialogs/gcode_settings.py:839 ui_dialogs/sizing.py:2044
#: ui_dialogs/sizing.py:2742
msgid "Preset name cannot be empty."
msgstr "Il nome del preset non può essere vuoto."

#: ui_dialogs/gcode_settings.py:846 ui_dialogs/sizing.py:2051
#, python-brace-format
msgid "A preset named '{new}' already exists."
msgstr "Esiste già un preset chiamato '{new}'."

#: ui_dialogs/gcode_settings.py:868
#, python-brace-format
msgid ""
"At least one {label} preset must remain. Save another preset before "
"deleting this one."
msgstr ""
"Deve rimanere almeno un preset {label}. Salvi un altro preset prima di "
"eliminare questo."

#: ui_dialogs/gcode_settings.py:874 ui_dialogs/sizing.py:2074
#, python-brace-format
msgid "Delete preset '{name}'?"
msgstr "Eliminare il preset '{name}'?"

#: ui_dialogs/gcode_settings.py:911 ui_dialogs/gcode_settings.py:920
#: ui_dialogs/sizing.py:1659
msgid "Unsaved changes"
msgstr "Modifiche non salvate"

#: ui_dialogs/gcode_settings.py:913
#, python-brace-format
msgid ""
"You have edits to {labels} that aren't saved as a preset.\n"
"\n"
"Save them as preset(s)?\n"
"\n"
"• Yes — save each as a preset, then apply.\n"
"• No — apply anyway (edits stay in settings but aren't a preset).\n"
"• Cancel — keep editing."
msgstr ""
"Sono presenti modifiche a {labels} non salvate come preset.\n"
"\n"
"Salvarle come preset?\n"
"\n"
"• Sì — salva ciascuna come preset, poi applica.\n"
"• No — applica comunque (le modifiche restano nelle impostazioni ma non "
"come preset).\n"
"• Annulla — continua a modificare."

#: ui_dialogs/gcode_settings.py:922
#, python-brace-format
msgid ""
"You have edits to {labels} that aren't saved as a preset.\n"
"\n"
"Save them as preset(s) before closing?\n"
"\n"
"• Yes — save each as a preset, then close (changes won't apply).\n"
"• No — discard edits and close.\n"
"• Cancel — keep editing."
msgstr ""
"Sono presenti modifiche a {labels} non salvate come preset.\n"
"\n"
"Salvarle come preset prima di chiudere?\n"
"\n"
"• Sì — salva ciascuna come preset, poi chiudi (le modifiche non verranno "
"applicate).\n"
"• No — scarta le modifiche e chiudi.\n"
"• Annulla — continua a modificare."

#: ui_dialogs/gcode_settings.py:964 ui_dialogs/gcode_settings.py:1010
#, python-brace-format
msgid "Invalid value for {mat} {op}. Please enter valid numbers."
msgstr "Valore non valido per {op} di {mat}. Inserisca numeri validi."

#: ui_dialogs/gcode_settings.py:979
#, python-brace-format
msgid "Invalid value for {mat} line engraving. Please enter valid numbers."
msgstr ""
"Valore non valido per l'incisione a linea di {mat}. Inserisca numeri "
"validi."

#: ui_dialogs/gcode_settings.py:990
#, python-brace-format
msgid "Invalid value for {mat} filled engraving. Please enter valid numbers."
msgstr "Valore non valido per l'incisione piena di {mat}. Inserisca numeri validi."

#: ui_dialogs/gcode_settings.py:1019
#, python-brace-format
msgid "Invalid kerf width for {mat}. Please enter a valid number."
msgstr "Larghezza kerf non valida per {mat}. Inserisca un numero valido."

#: ui_dialogs/gcode_settings.py:1041
msgid "Font sizes must be valid numbers."
msgstr "Le dimensioni dei caratteri devono essere numeri validi."

#: ui_dialogs/gcode_settings.py:1050
msgid "Return speed must be a valid number."
msgstr "La velocità di ritorno deve essere un numero valido."

