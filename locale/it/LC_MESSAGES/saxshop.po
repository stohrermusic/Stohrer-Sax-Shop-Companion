msgstr "La misura minima deve essere inferiore a quella massima."

#: ui_dialogs.py:1148 ui_dialogs.py:1162 ui_dialogs.py:1299 ui_dialogs.py:1312
#: ui_dialogs.py:1379 ui_dialogs.py:1392 ui_dialogs.py:1462 ui_dialogs.py:1475
#: ui_dialogs.py:2761
msgid "No Selection"
msgstr "Nessuna selezione"

#: ui_dialogs.py:1148 ui_dialogs.py:1299 ui_dialogs.py:1379 ui_dialogs.py:1462
