msgstr "Una sola fotocamera"

#: ui_dialogs.py:9261 ui_dialogs.py:9920 ui_dialogs.py:11184
msgid "Only one camera is detected."
msgstr "Rilevata una sola fotocamera."

#: ui_dialogs.py:9265
msgid "Switch Camera?"
msgstr "Cambiare fotocamera?"

#: ui_dialogs.py:9266
#, python-brace-format
