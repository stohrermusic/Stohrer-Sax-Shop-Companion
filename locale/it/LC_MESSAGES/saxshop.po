#, python-brace-format
msgid "Pass {n} complete — waiting for Idle..."
msgstr "Passata {n} completata — in attesa di Idle..."

#: ui_dialogs.py:8996
msgid "Complete ✓"
msgstr "Completato ✓"

#: ui_dialogs.py:8998
msgid "Stopped"
msgstr "Fermato"

#: ui_dialogs.py:9003
msgid "unknown error"
msgstr "errore sconosciuto"

#: ui_dialogs.py:9008
#, python-brace-format
msgid "Stopped on error: {e}"
msgstr "Fermato per errore: {e}"

#: ui_dialogs.py:9010
#, python-brace-format
msgid "  — {d}"
msgstr "  — {d}"

#: ui_dialogs.py:9012
#, python-brace-format
msgid ""
"\n"
"Failing line {n}: {l}"
msgstr ""
"\n"
"Riga fallita {n}: {l}"

#: ui_dialogs.py:9044
#, python-brace-format
msgid "Jog the head to your material's bottom-left corner, then click {label}."
msgstr ""
"Muovi la testa all'angolo in basso a sinistra del materiale, poi clicca "
"{label}."

#: ui_dialogs.py:9110
#, python-brace-format
msgid "Timed out waiting for Idle (state={s})"
msgstr "Timeout in attesa di Idle (stato={s})"

#: ui_dialogs.py:9135
#, python-brace-format
msgid "Regenerate failed: {e}"
msgstr "Rigenerazione fallita: {e}"

#: ui_dialogs.py:9142
#, python-brace-format
msgid "Restart failed: {e}"
msgstr "Riavvio fallito: {e}"

#: ui_dialogs.py:9164
msgid "Lid Closed?"
msgstr "Coperchio chiuso?"

#: ui_dialogs.py:9165
msgid ""
"Is the laser's lid closed?\n"
"\n"
"Starting with it open throws the laser into an error state that needs a "
"power cycle to clear."
msgstr ""
"Il coperchio del laser è chiuso?\n"
"\n"
"Avviare con il coperchio aperto manda il laser in stato di errore, "
"risolvibile solo spegnendo e riaccendendo."

#: ui_dialogs.py:9178 ui_dialogs.py:9348
msgid "Finishing pass..."
msgstr "Completamento passata..."

#: ui_dialogs.py:9182
msgid "Cut requested — finishing current framing pass..."
msgstr "Richiesto taglio — completamento della passata di inquadratura..."

#: ui_dialogs.py:9207
#, python-brace-format
msgid "Head positioned. Click {label} when ready."
msgstr "Testa posizionata. Clicca {label} quando sei pronto."

#: ui_dialogs.py:9221
msgid "Homing will abort the run in progress. Continue?"
msgstr "L'azzeramento interromperà il lavoro in corso. Continuare?"

#: ui_dialogs.py:9267
msgid "Homing complete. MPos is now (0, 0)."
msgstr "Azzeramento completato. MPos ora è (0, 0)."

#: ui_dialogs.py:9269
#, python-brace-format
msgid "Homing failed: {m}"
msgstr "Azzeramento fallito: {m}"

#: ui_dialogs.py:9296
#, python-brace-format
msgid "Auto-locate failed: {e}"
msgstr "Localizzazione automatica fallita: {e}"

#: ui_dialogs.py:9298
#, python-brace-format
msgid "Driving to polygon BL at MPos ({x:.1f}, {y:.1f}) …"
msgstr "Spostamento verso il BL del poligono a MPos ({x:.1f}, {y:.1f}) …"

#: ui_dialogs.py:9352
msgid "Finishing current pass + centering head..."
msgstr "Completamento della passata corrente e centratura della testa..."

#: ui_dialogs.py:9357
msgid "Stop?"
msgstr "Fermare?"

#: ui_dialogs.py:9358
msgid ""
"Stop the job? This will soft-reset the laser and clear the planner buffer"
" immediately. Material in progress may be ruined."
msgstr ""
"Fermare il lavoro? Verrà eseguito un soft-reset del laser e il buffer del"
" planner sarà svuotato immediatamente. Il materiale in lavorazione "
"potrebbe rovinarsi."

#: ui_dialogs.py:9372
msgid "Stop and close?"
msgstr "Fermare e chiudere?"

#: ui_dialogs.py:9373
msgid "A job is still running. Stop it and close the window?"
msgstr "Un lavoro è ancora in esecuzione. Fermarlo e chiudere la finestra?"

#: ui_dialogs.py:9403 ui_dialogs.py:9413
#, python-brace-format
msgid "Elapsed {em}:{es:02d}"
msgstr "Trascorso {em}:{es:02d}"

#: ui_dialogs.py:9410
#, python-brace-format
msgid "Elapsed {em}:{es:02d}  ETA ~{rm}:{rs:02d}"
msgstr "Trascorso {em}:{es:02d}  ETA ~{rm}:{rs:02d}"

#: ui_dialogs.py:9436
msgid "Live camera"
msgstr "Fotocamera live"

#: ui_dialogs.py:9456
msgid "Camera preview unavailable"
msgstr "Anteprima fotocamera non disponibile"

