msgstr "Azzerare il laser? La testa andrà all'angolo di origine a piena velocità."

#: ui_dialogs.py:8426 ui_dialogs.py:10891 ui_dialogs.py:10894
msgid "Homing..."
msgstr "Azzeramento in corso..."

#: ui_dialogs.py:8461
