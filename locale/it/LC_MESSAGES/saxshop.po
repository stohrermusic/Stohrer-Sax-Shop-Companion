msgid "Kerf Test — {material_name}"
msgstr "Test del kerf — {material_name}"

#: tooling_tab.py:1382
msgid "1.  Cut the pattern on your material"
msgstr "1.  Tagli il pattern sul suo materiale"

#: tooling_tab.py:1383
msgid "2.  Pop out the 3 discs (10mm, 20mm, 30mm)"
msgstr "2.  Estragga i 3 dischi (10mm, 20mm, 30mm)"

#: tooling_tab.py:1384
msgid ""
"3.  For each circle, measure the hole ID\n"
"     and disc OD with calipers"
msgstr ""
"3.  Per ogni cerchio, misuri il diametro interno del foro\n"
"     e il diametro esterno del disco con un calibro"

#: tooling_tab.py:1386
msgid "4.  Kerf = hole ID − disc OD"
msgstr "4.  Kerf = diametro foro − diametro disco"

#: tooling_tab.py:1387
msgid "5.  Average the 3 results for best accuracy"
msgstr "5.  Faccia la media dei 3 risultati per la massima precisione"

#: tooling_tab.py:1388
#, python-brace-format
