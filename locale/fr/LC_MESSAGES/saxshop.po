msgid " as a paying member"
msgstr " en tant que membre payant"

#: ui_dialogs.py:6942
msgid ""
"Or email me for my address to send a six-pack,\n"
"some old tools, or whatever!"
msgstr ""
"Ou écrivez-moi par e-mail pour mon adresse, afin de m'envoyer un pack de "
"bières,\n"
"de vieux outils ou autre chose !"

