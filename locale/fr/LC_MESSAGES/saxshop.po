#: ui_dialogs.py:6908
msgid "Questions or feedback:"
msgstr "Questions ou commentaires :"

#: ui_dialogs.py:6918
msgid "Like this app? Want to say thanks?"
msgstr "Vous aimez cette application ? Envie de dire merci ?"

#: ui_dialogs.py:6921
msgid ""
"PayPal: stohrermusic@gmail.com\n"
"Venmo: @matthew-stohrer"
msgstr ""
"PayPal : stohrermusic@gmail.com\n"
"Venmo : @matthew-stohrer"

#: ui_dialogs.py:6930
msgid "Join my "
msgstr "Rejoignez ma "

#: ui_dialogs.py:6932
msgid "YouTube channel"
msgstr "chaîne YouTube"

