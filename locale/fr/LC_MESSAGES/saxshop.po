msgstr "Échec de la réinitialisation"

#: machine_control.py:866
#, python-brace-format
msgid "Couldn't reset: {e}"
msgstr "Impossible de réinitialiser : {e}"

#: machine_control.py:877
msgid "Falcon Reset"
msgstr "Falcon réinitialisé"

#: machine_control.py:878
msgid ""
"Soft-reset sent. The Falcon is now in alarm state — use Home Laser to "
"recover, then jog as needed."
msgstr ""
"Soft-reset envoyé. Le Falcon est en état d'alarme — utilise Origine du "
"laser pour récupérer, puis déplace la tête au besoin."

