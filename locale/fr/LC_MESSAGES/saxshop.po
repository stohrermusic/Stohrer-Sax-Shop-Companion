msgid "Min size must be less than max size."
msgstr "La taille min. doit être inférieure à la taille max."

#: ui_dialogs.py:1566 ui_dialogs.py:1580 ui_dialogs.py:1717 ui_dialogs.py:1730
#: ui_dialogs.py:1797 ui_dialogs.py:1810 ui_dialogs.py:1880 ui_dialogs.py:1893
#: ui_dialogs.py:3410
