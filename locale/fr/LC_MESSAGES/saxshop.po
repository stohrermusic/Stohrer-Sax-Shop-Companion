msgstr "Afficher le champ « {key_name} »"

#: ui_dialogs.py:3205
#, python-brace-format
msgid ""
"Show the '{key_name}' measurement field on key-height sets. Hide fields "
"you never measure to keep the layout compact."
msgstr ""
"Affiche le champ de mesure « {key_name} » sur les jeux de hauteurs. "
"Masquez les champs que vous ne mesurez jamais pour garder une mise en "
"page compacte."

