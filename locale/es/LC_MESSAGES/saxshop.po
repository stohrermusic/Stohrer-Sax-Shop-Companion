"At least one {label} preset must remain. Save another preset before "
"deleting this one."
msgstr ""
"Debe quedar al menos un preajuste de {label}. Guarde otro preajuste antes"
" de eliminar este."

#: ui_dialogs/gcode_settings.py:874 ui_dialogs/sizing.py:2074
#, python-brace-format
msgid "Delete preset '{name}'?"
msgstr "¿Eliminar el preajuste '{name}'?"

