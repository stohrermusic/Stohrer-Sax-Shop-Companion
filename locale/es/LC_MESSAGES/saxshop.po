msgstr "Mostrar etiqueta de tamaño"

#: ui_dialogs.py:940
msgid "Engrave the pad-size number on each disc for identification."
msgstr ""
"Grabar el número de tamaño de la zapatilla en cada disco para su "
"identificación."

#: ui_dialogs.py:942 ui_dialogs.py:988
msgid "Font Sizes (mm)"
msgstr "Tamaños de fuente (mm)"

