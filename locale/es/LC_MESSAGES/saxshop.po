msgstr "Capturar (tarjeta movida)"

#: ui_dialogs/machine.py:2395
#, python-brace-format
msgid ""
"References done ({n} pooled). Now MOVE the card to different positions / "
"tilts and capture {m} more frames for lens-distortion calibration."
msgstr ""
"Referencias hechas ({n} combinadas). Ahora MUEVE la tarjeta a distintas "
