msgstr "Guardar preajuste de dimensionado"

#: ui_dialogs.py:2944
msgid "Save the current sizing-rules form as a preset."
msgstr "Guardar el formulario actual de reglas de dimensionado como preajuste."

#: ui_dialogs.py:2952
msgid "Overwrite existing:"
msgstr "Sobrescribir existente:"

#: ui_dialogs.py:2971
msgid "Save as new preset:"
msgstr "Guardar como nuevo preajuste:"

#: ui_dialogs.py:3015
msgid "Pick a preset to overwrite."
msgstr "Elija un preajuste para sobrescribir."

#: ui_dialogs.py:3018
msgid "Overwrite Preset"
msgstr "Sobrescribir preajuste"

#: ui_dialogs.py:3019
#, python-brace-format
msgid "Overwrite '{target}' with the current values?"
msgstr "¿Sobrescribir '{target}' con los valores actuales?"

#: ui_dialogs.py:3034
#, python-brace-format
msgid ""
"A preset named '{name}' already exists.\n"
"Use Overwrite, or choose a different name."
msgstr ""
"Ya existe un preajuste llamado '{name}'.\n"
"Use Sobrescribir, o elija un nombre diferente."

#: ui_dialogs.py:3048
msgid "Layer Color Mapping"
msgstr "Asignación de colores de capa"

#: ui_dialogs.py:3079
#, python-brace-format
msgid "{material} outline"
msgstr "{material}: contorno"

#: ui_dialogs.py:3080
#, python-brace-format
msgid "{material} center hole"
msgstr "{material}: agujero central"

#: ui_dialogs.py:3081
#, python-brace-format
msgid "{material} engraving"
msgstr "{material}: grabado"

#: ui_dialogs.py:3082 ui_dialogs.py:6326
#, python-brace-format
msgid "{material} locator marks"
msgstr "{material}: marcas de posición"

#: ui_dialogs.py:3083
#, python-brace-format
msgid "{material} cut"
msgstr "{material}: corte"

#: ui_dialogs.py:3102
msgid "LightBurn layer color for this step's lines in the SVG output."
msgstr "Color de capa de LightBurn para las líneas de este paso en el SVG."

#: ui_dialogs.py:3104
msgid ""
"LightBurn layer color used for the adhesive rings in the SVG output: the "
"cuts and the size number share it."
msgstr ""
"Color de capa de LightBurn para los anillos adhesivos en el SVG: los "
"cortes y el número de tamaño lo comparten."

#: ui_dialogs.py:3114
msgid "Apply the color choices and close."
msgstr "Aplicar las elecciones de color y cerrar."

#: ui_dialogs.py:3115
msgid "Close without changing layer colors."
msgstr "Cerrar sin cambiar los colores de capa."

#: ui_dialogs.py:3139
msgid "Key Height Layout Options"
msgstr "Opciones de disposición de alturas de llave"

#: ui_dialogs.py:3153
msgid "Apply the layout changes and close."
msgstr "Aplicar los cambios de disposición y cerrar."

#: ui_dialogs.py:3154
msgid "Close without changing the layout."
msgstr "Cerrar sin cambiar la disposición."

#: ui_dialogs.py:3178
msgid "Horn Info Layout"
msgstr "Disposición de la información del saxofón"

#: ui_dialogs.py:3184
msgid "Show 'Serial' field"
msgstr "Mostrar el campo 'Serie'"

#: ui_dialogs.py:3187
msgid ""
"Show a Serial field in the horn-info header for each key-height set, so "
"you can record the saxophone's serial number alongside the measurements."
msgstr ""
"Mostrar un campo Serie en la cabecera de información del saxofón para "
"cada conjunto de alturas de llave, de modo que pueda registrar el número "
"de serie del saxofón junto a las mediciones."

#: ui_dialogs.py:3194
msgid "Use large 'Notes' field"
msgstr "Usar campo 'Notas' grande"

#: ui_dialogs.py:3197
msgid ""
"Use a multi-line Notes field instead of a single line, good for jotting "
"setup observations or repair history."
msgstr ""
"Usar un campo de Notas de varias líneas en lugar de una sola línea, útil "
"para anotar observaciones de configuración o historial de reparaciones."

#: ui_dialogs.py:3200
msgid "Visible Key Heights"
msgstr "Alturas de llave visibles"

#: ui_dialogs.py:3207
#, python-brace-format
msgid "Show '{key_name}' field"
msgstr "Mostrar el campo '{key_name}'"

#: ui_dialogs.py:3210
#, python-brace-format
msgid ""
"Show the '{key_name}' measurement field on key-height sets. Hide fields "
"you never measure to keep the layout compact."
msgstr ""
"Muestra el campo de medición '{key_name}' en los conjuntos de alturas de "
"llave. Oculte los campos que nunca mide para mantener la disposición "
"compacta."

