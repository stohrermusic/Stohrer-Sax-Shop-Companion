msgstr "No se pudo reiniciar: {e}"

#: machine_control.py:877
msgid "Falcon Reset"
msgstr "Falcon reiniciado"

#: machine_control.py:878
msgid ""
"Soft-reset sent. The Falcon is now in alarm state — use Home Laser to "
"recover, then jog as needed."
msgstr ""
"Soft-reset enviado. El Falcon está en estado de alarma — usa Reposicionar"
" láser para recuperarte, luego mueve el cabezal como necesites."

