msgstr "No se pudo abrir la cámara: {e}"

#: ui_dialogs.py:10061
#, python-brace-format
msgid ""
"This camera is sending {fw}×{fh} images, but the calibration was made at "
"{cw}×{ch}. Recalibrate, or use Switch camera if this is the wrong one."
msgstr ""
"Esta cámara envía imágenes de {fw}×{fh}, pero la calibración se hizo a "
