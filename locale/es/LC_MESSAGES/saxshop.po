msgstr "El nombre del preajuste no puede estar vacío."

#: ui_dialogs.py:2338 ui_dialogs.py:5307
#, python-brace-format
msgid "A preset named '{new}' already exists."
msgstr "Ya existe un preajuste llamado '{new}'."

#: ui_dialogs.py:2356
msgid ""
"At least one sizing preset must remain. Save another preset before "
"deleting this one."
msgstr ""
"Debe quedar al menos un preajuste de dimensionado. Guarde otro preajuste "
"antes de eliminar este."

#: ui_dialogs.py:2361 ui_dialogs.py:5335
#, python-brace-format
msgid "Delete preset '{name}'?"
msgstr "¿Eliminar el preajuste '{name}'?"

