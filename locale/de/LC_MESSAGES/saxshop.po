#: tooling_tab.py:1370 tooling_tab.py:1378
#, python-brace-format
msgid "Kerf Test — {material_name}"
msgstr "Schnittfugen-Test – {material_name}"

#: tooling_tab.py:1382
msgid "1.  Cut the pattern on your material"
msgstr "1.  Schneiden Sie das Muster aus Ihrem Material."

#: tooling_tab.py:1383
msgid "2.  Pop out the 3 discs (10mm, 20mm, 30mm)"
msgstr "2.  Drücken Sie die 3 Scheiben heraus (10 mm, 20 mm, 30 mm)."

#: tooling_tab.py:1384
msgid ""
"3.  For each circle, measure the hole ID\n"
"     and disc OD with calipers"
msgstr ""
"3.  Messen Sie für jeden Kreis den Loch-Innendurchmesser\n"
"     und den Scheiben-Außendurchmesser mit einer Schieblehre."

#: tooling_tab.py:1386
msgid "4.  Kerf = hole ID − disc OD"
msgstr "4.  Schnittfuge = Loch-ID − Scheiben-AD"

#: tooling_tab.py:1387
msgid "5.  Average the 3 results for best accuracy"
msgstr "5.  Mitteln Sie die 3 Ergebnisse für höchste Genauigkeit."

#: tooling_tab.py:1388
#, python-brace-format
msgid ""
