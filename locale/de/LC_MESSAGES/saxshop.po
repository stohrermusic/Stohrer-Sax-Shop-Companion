msgid "Sheet width and height must be positive numbers."
msgstr "Blattbreite und -höhe müssen positive Zahlen sein."

#: tooling_tab.py:1656
msgid "Disc diameter must be a valid number."
msgstr "Der Scheibendurchmesser muss eine gültige Zahl sein."

#: tooling_tab.py:1660
msgid "Disc diameter must be greater than zero."
msgstr "Der Scheibendurchmesser muss größer als null sein."

#: tooling_tab.py:1667
msgid "Hole diameter must be a valid number (use 0 for a solid disc)."
msgstr ""
"Der Lochdurchmesser muss eine gültige Zahl sein (0 für eine volle "
"Scheibe)."

#: tooling_tab.py:1671
msgid "Hole diameter can't be negative (use 0 for a solid disc)."
msgstr "Der Lochdurchmesser darf nicht negativ sein (0 für eine volle Scheibe)."

#: tooling_tab.py:1675
msgid "Hole diameter must be smaller than the disc diameter."
msgstr "Der Lochdurchmesser muss kleiner als der Scheibendurchmesser sein."

#: tooling_tab.py:1683
msgid "Engraving speed and power must be valid numbers."
msgstr "Graviergeschwindigkeit und -leistung müssen gültige Zahlen sein."

#: tooling_tab.py:1687
msgid "Engraving speed must be > 0 and power must be 1-100%."
msgstr ""
"Die Graviergeschwindigkeit muss > 0 und die Leistung zwischen 1 und 100% "
"sein."

