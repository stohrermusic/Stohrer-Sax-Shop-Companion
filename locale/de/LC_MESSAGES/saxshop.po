msgstr "Schnittfugen-Test – {material_name}"

#: tooling_tab.py:1907
msgid "1.  Cut the pattern on your material"
msgstr "1.  Schneiden Sie das Muster aus Ihrem Material."

#: tooling_tab.py:1908
