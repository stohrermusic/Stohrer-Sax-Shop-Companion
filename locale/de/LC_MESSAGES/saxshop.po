"{error_msg}\n"
"\n"
"Click here to retry"
msgstr ""
"{error_msg}\n"
"\n"
"Hier klicken, um es erneut zu versuchen"

#: ui_dialogs.py:240
msgid "Send this file to the laser as it is. For LightBurn, use Generate SVG."
msgstr ""
"Senden Sie diese Datei unverändert an den Laser. Für LightBurn nehmen Sie"
" „SVG generieren“."

#: ui_dialogs.py:308
msgid "Don't show this message again"
msgstr "Diese Meldung nicht mehr anzeigen"

#: ui_dialogs.py:312
